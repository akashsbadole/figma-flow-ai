# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require
# Alternative connection string format:
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database Pool Settings (optional - defaults in config.js)
# DB_MAX_CONNECTIONS=20
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=2000

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_BASE_URL=https://api.minimax.chat/v1

# AI Settings (optional)
# AI_MAX_RETRIES=3
# AI_RETRY_DELAY_MS=1000

# Rate Limiting (optional)
# RATE_LIMIT_API_WINDOW_MS=900000
# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_AI_WINDOW_MS=60000
# RATE_LIMIT_AI_MAX=10

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx

# API URLs
API_URL=http://localhost:3001
CLIENT_URL=http://localhost:8080

# Client-side API URL (Vite)
VITE_API_URL=http://localhost:3001
VITE_CLIENT_URL=http://localhost:8080

# Logging (optional)
# LOG_LEVEL=info
# LOG_FORMAT=combined

# Security (optional - for future use)
# JWT_SECRET=your-jwt-secret
# SESSION_SECRET=your-session-secret
# BCRYPT_ROUNDS=10
